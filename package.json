{
  "name": "shopocalypse",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then : \"${DATABASE_URL:?must be set for production builds}\" && drizzle-kit migrate; fi && react-router build",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "@tabler/icons-react": "^3.44.0",
    "@vercel/react-router": "^1.3.7",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router": "7.15.1",
    "remark-breaks": "^4.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.1",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.3"
  }
}
