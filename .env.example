# libSQL database. Locally a file (the default if unset); on Vercel the Turso URL.
DATABASE_URL=file:shopocalypse.db
# Turso only: create with `turso db tokens create <db>`
DATABASE_AUTH_TOKEN=

# Shared password for HTTP Basic Auth (any user name). Required on Vercel;
# leave empty locally to run without a password.
APP_PASSWORD=


# Read by `yarn db:download` only, to copy production into shopocalypse.db.
# Kept apart from DATABASE_URL so nothing else can reach production by accident.
# A read-only token is enough: `turso db tokens create <db> --read-only`
PROD_DATABASE_URL=
PROD_DATABASE_AUTH_TOKEN=
